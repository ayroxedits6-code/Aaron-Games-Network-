  <meta name="theme-color" content="#071018">
  <title>GG MODS</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <div class="brand"><span class="brand-logo">GG</span><span>GG MODS</span></div>

      <nav class="side-nav">
        <button class="nav-link active" data-page="home">⌂ <span>Home</span></button>
        <button class="nav-link" data-page="games">🎮 <span>Games</span></button>
        <button class="nav-link" data-page="movies">🎬 <span>Movies</span></button>
        <button class="nav-link" data-page="chat">💬 <span>Chat</span></button>
        <button class="nav-link" data-page="members">👥 <span>Members</span></button>
        <button class="nav-link" data-page="coins">🪙 <span>Coins</span></button>
        <button class="nav-link" data-page="upcoming">📅 <span>Upcoming Games</span></button>
        <button class="nav-link" data-page="profile">👤 <span>Profile</span></button>
        <button class="nav-link" data-page="settings">⚙️ <span>Settings</span></button>
        <button class="nav-link admin-only" data-page="admin">🛡️ <span>Admin Panel</span></button>
      </nav>

      <div class="side-user">
        <div class="avatar" id="sideAvatar">GG</div>
        <div>
          <strong id="sideName">Guest</strong>
          <small id="sideStatus">Not signed in</small>
        </div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <button class="menu-btn" id="menuBtn">☰</button>

        <div class="search-box">
          <span>⌕</span>
          <input id="searchInput" placeholder="Search GG MODS...">
        </div>

        <button class="icon-btn" id="notificationBtn">🔔</button>

        <button class="profile-button" data-page="profile">
          <span class="avatar small" id="topAvatar">GG</span>
          <span id="topName">Guest</span>
        </button>
      </header>

      <div class="pages">

        <!-- HOME -->
        <section class="page active" id="page-home">
          <div class="hero">
            <div>
              <span class="eyebrow">WELCOME TO</span>
              <h1>GG MODS</h1>
              <p>
                A gaming community platform for games, movies,
                updates, members and real-time communication.
              </p>

              <div class="actions">
                <button class="primary" data-page="games">Explore Games</button>
                <button class="secondary" data-page="chat">Open Chat</button>
              </div>
            </div>

            <div class="hero-logo">
              GG
              <small>MODS</small>
            </div>
          </div>

          <div class="section-title">
            <div>
              <span class="eyebrow">DISCOVER</span>
              <h2>Popular Games</h2>
            </div>
            <button class="link-btn" data-page="games">View all →</button>
          </div>

          <div class="carousel-wrap">
            <button class="carousel-control" id="prevPopular">‹</button>

            <div id="popularGrid" class="game-grid">
              <div class="empty">No games have been added yet.</div>
            </div>

            <button class="carousel-control" id="nextPopular">›</button>
          </div>

          <div class="dots" id="popularDots"></div>

          <div class="section-title">
            <div>
              <span class="eyebrow">COMMUNITY</span>
              <h2>Latest Posts</h2>
            </div>
          </div>

          <div id="posts" class="post-list">
            <div class="empty">No posts have been added yet.</div>
          </div>
        </section>

        <!-- GAMES -->
        <section class="page" id="page-games">
          <div class="page-title">
            <div>
              <span class="eyebrow">LIBRARY</span>
              <h1>Games</h1>
            </div>

            <button class="primary admin-only" id="addGameBtn">
              + Add Game
            </button>
          </div>

          <div class="filters">
            <input class="field" id="gameSearch" placeholder="Search games...">

            <select class="field" id="gameCategory">
              <option value="">All categories</option>
              <option>Football</option>
              <option>Action</option>
              <option>Racing</option>
              <option>Adventure</option>
            </select>
          </div>

          <div id="gamesGrid" class="game-grid">
            <div class="empty">No games have been added yet.</div>
          </div>
        </section>

        <!-- MOVIES -->
        <section class="page" id="page-movies">
          <div class="page-title">
            <div>
              <span class="eyebrow">WATCH</span>
              <h1>Movies</h1>
            </div>

            <button class="primary admin-only" id="addMovieBtn">
              + Add Movie
            </button>
          </div>

          <div class="live-card">
            <span class="live-dot"></span>

            <div>
              <strong>Live Movies</strong>
              <small>Authorized live streams can appear here.</small>
            </div>

            <button class="secondary" id="liveBtn">Open Live</button>
          </div>

          <div id="moviesGrid" class="game-grid">
            <div class="empty">No movies have been added yet.</div>
          </div>
        </section>

        <!-- CHAT -->
        <section class="page" id="page-chat">
          <div class="page-title">
            <div>
              <span class="eyebrow">COMMUNITY</span>
              <h1>Chat</h1>
            </div>
          </div>

          <div class="chat-tabs">
            <button class="active" data-chat-tab="members">Members</button>
            <button data-chat-tab="dm">DMs</button>
            <button data-chat-tab="group">Group Chat</button>
          </div>

          <div class="chat-layout">
            <aside class="chat-list" id="chatList">
              <div class="empty">
                Sign in to see members and conversations.
              </div>
            </aside>

            <div class="chat-window">
              <div class="chat-header">
                <div class="avatar">GG</div>

                <div>
                  <strong id="chatTitle">GG MODS Group Chat</strong>
                  <small id="chatSubtitle">Community room</small>
                </div>

                <button class="icon-btn" id="voiceCallBtn">📞</button>
              </div>

              <div class="messages" id="messages">
                <div class="empty">No messages yet.</div>
              </div>

              <form class="composer" id="messageForm">
                <button type="button" class="icon-btn" id="emojiBtn">😊</button>

                <input
                  id="messageInput"
                  autocomplete="off"
                  placeholder="Write a message..."
                >

                <button class="primary" type="submit">Send</button>
              </form>
            </div>
          </div>
        </section>

        <!-- MEMBERS -->
        <section class="page" id="page-members">
          <div class="page-title">
            <div>
              <span class="eyebrow">COMMUNITY</span>
              <h1>Members</h1>
            </div>
          </div>

          <div class="member-count">
            Registered members:
            <strong id="memberCount">0</strong>
          </div>

          <div id="membersGrid" class="members-grid">
            <div class="empty">No members to display yet.</div>
          </div>
        </section>

        <!-- COINS -->
        <section class="page" id="page-coins">
          <div class="page-title">
            <div>
              <span class="eyebrow">REWARDS</span>
              <h1>Coins</h1>
            </div>
          </div>

          <div class="coin-card">
            <div class="coin-icon">🪙</div>

            <div>
              <small>Your balance</small>
              <strong id="coinBalance">0</strong>
              <span>GG Coins</span>
            </div>
          </div>

          <div class="section-title">
            <h2>Transaction History</h2>
          </div>

          <div id="transactions" class="transactions">
            <div class="empty">No transactions yet.</div>
          </div>
        </section>

        <!-- UPCOMING -->
        <section class="page" id="page-upcoming">
          <div class="page-title">
            <div>
              <span class="eyebrow">REQUESTS</span>
              <h1>Upcoming Games</h1>
            </div>

            <button class="primary admin-only" id="addUpcomingBtn">
              + Add Upcoming Game
            </button>
          </div>

          <div id="upcomingGrid" class="game-grid">
            <div class="empty">
              No upcoming games have been added yet.
            </div>
          </div>
        </section>

        <!-- PROFILE -->
        <section class="page" id="page-profile">
          <div class="profile-banner">
            <div class="avatar xl" id="profileAvatar">GG</div>

            <div>
              <span class="eyebrow">PROFILE</span>
              <h1 id="profileName">Guest</h1>
              <p id="profileBio">
                Sign in to create your GG MODS profile.
              </p>
            </div>
          </div>

          <div class="settings-card">
            <h2>Edit Profile</h2>

            <label>
              Display name
              <input
                class="field"
                id="displayName"
                maxlength="40"
                placeholder="Your name"
              >
            </label>

            <label>
              Bio
              <textarea
                class="field"
                id="bio"
                maxlength="160"
                placeholder="Tell the community about you"
              ></textarea>
            </label>

            <button class="primary" id="saveProfile">
              Save Profile
            </button>

            <button class="secondary" id="signInBtn">
              Sign in / Create local account
            </button>
          </div>
        </section>

        <!-- SETTINGS -->
        <section class="page" id="page-settings">
          <div class="page-title">
            <div>
              <span class="eyebrow">PREFERENCES</span>
              <h1>Settings</h1>
            </div>
          </div>

          <div class="settings-card">
            <h2>Appearance</h2>

            <p class="muted">
              Choose a complete GG MODS theme.
            </p>

            <div class="theme-grid">
              <button class="theme red" data-theme="red">RED</button>
              <button class="theme blue" data-theme="blue">BLUE</button>
              <button class="theme green" data-theme="green">GREEN</button>
              <button class="theme white" data-theme="white">WHITE</button>
              <button class="theme neon" data-theme="neon">BLACK NEON</button>
            </div>

            <hr>

            <h2>Notifications</h2>

            <label class="switch-row">
              <span>Enable notifications</span>
              <input type="checkbox" id="notificationsToggle" checked>
            </label>

            <hr>

            <h2>Account</h2>

            <button class="secondary" id="logoutBtn">
              Log out
            </button>
          </div>
        </section>

        <!-- ADMIN -->
        <section class="page admin-only" id="page-admin">
          <div class="page-title">
            <div>
              <span class="eyebrow">PRIVATE</span>
              <h1>Admin Panel</h1>
            </div>
          </div>

          <div class="stats">
            <div class="stat">
              <span>Registered Members</span>
              <strong id="statMembers">0</strong>
            </div>

            <div class="stat">
              <span>Games</span>
              <strong id="statGames">0</strong>
            </div>

            <div class="stat">
              <span>Movies</span>
              <strong id="statMovies">0</strong>
            </div>

            <div class="stat">
              <span>Transactions</span>
              <strong id="statTransactions">0</strong>
            </div>
          </div>

          <div class="settings-card">
            <h2>Content management</h2>

            <p class="muted">
              This starter UI is ready to connect to a real backend.
              Admin permissions must be enforced by backend/database
              rules, not by this frontend alone.
            </p>

            <div class="admin-actions">
              <button class="secondary" id="adminGameAction">Add Game</button>
              <button class="secondary" id="adminMovieAction">Add Movie</button>
              <button class="secondary" id="adminCoinAction">Give Coins</button>
            </div>
          </div>
        </section>

      </div>
    </main>

    <nav class="bottom-nav">
      <button class="active" data-page="home">⌂<small>Home</small></button>
      <button data-page="games">🎮<small>Games</small></button>
      <button data-page="movies">🎬<small>Movies</small></button>
      <button data-page="chat">💬<small>Chat</small></button>
      <button data-page="profile">👤<small>Profile</small></button>
    </nav>
  </div>

  <div class="toast" id="toast"></div>

  <script src="app.js"></script>
</body>
</html>
